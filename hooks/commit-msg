#!/bin/sh
# Installed by `make setup` through core.hooksPath.
# Refuses commit messages with a word from docs/style/banned.txt. Claudeisms
# and possible "X is the Y" lines print as warnings only.
set -eu

msg=$(sed -e '/^# ------------------------ >8 ------------------------$/,$d' -e '/^#/d' "$1")
printf '%s\n' "$msg" | python3 tools/style_check.py - || {
    echo "commit-msg: reword the message (banned words: docs/style/banned.txt)" >&2
    exit 1
}
