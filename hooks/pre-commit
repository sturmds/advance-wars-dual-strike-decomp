#!/bin/sh
# Installed by `make setup` through core.hooksPath.
# 1. Refuse files that must never enter git (D5, tenet 9): the ROM, extracted
#    data and the map files unpacked from it, builds, local work files, and
#    sound in any form (archive files, WAV, MIDI, MP3, Ogg, SoundFont).
# 2. Run `make release`. It builds the working tree, not only the staged
#    changes, so stage everything you built with before committing. Skip it
#    when the tree has already passed make release in this checkout or a
#    worktree of it (tools/release_cache.py: the working tree must equal
#    the index, with no untracked files; PROGRESS.* do not count).
#    RELEASE_CACHE=off runs it in full.
#    Inside a landing (LAND_SELF_REPLAY=1, set only by land_self.py for the
#    replay it starts and by rebase_onto_mainline.py --continue of that
#    replay; only in a linked worktree) it stops after step 1:
#    land_self.py runs one make release on the final tree instead of one
#    per replayed commit.
# 3. Rewrite PROGRESS.md from the decomp.dev report that make release just
#    wrote, copy the report to PROGRESS.json, and stage both, so they go into
#    this commit. .github/workflows/decomp-dev.yml uploads PROGRESS.json. Not in
#    a linked worktree (an agent's): mainline writes it when the commit
#    lands, and agent commits that carry it conflict with each other.
set -eu

# Tenet 8: commit dates carry +0000, not the committer's timezone.
if [ "$(date +%z)" != "+0000" ] && [ -z "${GIT_COMMITTER_DATE:-}" ]; then
    echo "pre-commit: the local timezone is $(date +%z); commit with TZ=UTC (for example: export TZ=UTC)" >&2
    exit 1
fi

bad=$(git diff --cached --name-only --diff-filter=ACMR | grep -v -E '^(extract|extracted)/(README\.md|\.gitkeep)$' | grep -E '(^|/)(orig|extract|extracted|build|work)/|^assets/maps/[^/]+/|\.(nds|bin|o|exe|sdat|sseq|ssar|sbnk|swar|strm|wav|mid|mp3|ogg|flac|sf2|ncsf|minincsf|ncsflib)$' || true)
if [ -n "$bad" ]; then
    echo "pre-commit: these paths must not enter git:" >&2
    echo "$bad" | sed 's/^/  /' >&2
    exit 1
fi

linked=
if [ "$(git rev-parse --path-format=absolute --git-dir)" != "$(git rev-parse --path-format=absolute --git-common-dir)" ]; then
    linked=1
fi

if [ "${LAND_SELF_REPLAY:-}" = 1 ] && [ -n "$linked" ]; then
    echo "pre-commit: replayed inside a landing; land_self.py runs make release on the final tree"
    exit 0
fi

if [ -z "$linked" ]; then
    # --report: a skipped release still leaves the decomp.dev report of this tree.
    python3 tools/release_cache.py release --report --label pre-commit
    python3 tools/progress.py --write PROGRESS.md
    git add PROGRESS.md PROGRESS.json
else
    python3 tools/release_cache.py release --label pre-commit
fi
