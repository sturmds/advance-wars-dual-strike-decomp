#!/bin/sh
# Installed by `make setup` through core.hooksPath.
# 1. Refuse files that must never enter git (D5, tenet 9): the ROM, extracted
#    data and the map files unpacked from it, builds, and local work files.
# 2. Run `make release`. It builds the working tree, not only the staged
#    changes, so stage everything you built with before committing.
# 3. Rewrite PROGRESS.md and stage it, so it goes into this commit. Not in
#    a linked worktree (an agent's): mainline writes it when the commit
#    lands, and agent commits that carry it conflict with each other.
set -eu

# Tenet 8: commit dates carry +0000, not the committer's timezone.
if [ "$(date +%z)" != "+0000" ] && [ -z "${GIT_COMMITTER_DATE:-}" ]; then
    echo "pre-commit: the local timezone is $(date +%z); commit with TZ=UTC (for example: export TZ=UTC)" >&2
    exit 1
fi

bad=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '(^|/)(orig|extract|extracted|build|work)/|^assets/maps/[^/]+/|\.(nds|bin|o|exe)$' || true)
if [ -n "$bad" ]; then
    echo "pre-commit: these paths must not enter git:" >&2
    echo "$bad" | sed 's/^/  /' >&2
    exit 1
fi

make release
if [ "$(git rev-parse --path-format=absolute --git-dir)" = "$(git rev-parse --path-format=absolute --git-common-dir)" ]; then
    python3 tools/progress.py --write PROGRESS.md
    git add PROGRESS.md
fi
