# Inputs and outputs that never enter git (D5).
/orig
/extract/
/build/
/.cache

# Binary types refused by hooks/pre-commit as well.
*.nds
*.bin
*.o
*.exe

# Python
/.venv/
__pycache__/
*.pyc

# Editor and OS
*.swp
*~
.DS_Store
/build.ninja
/.ninja_log
/.ninja_deps
/objdiff.json

# Agent worktrees
/.claude/worktrees/

# Generated or local-only, never in git
/extracted
/work/
/.claude/
/assets/maps/*/
